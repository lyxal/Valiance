define evaluate(expr: String)<Panic[UnwrappedNoneFault]>
-> Result[Number, ValueError] =>
  $stack: Number+ = []
  $expr split(" ") foreach (token) =>
    $token match =>
      if in "+-*/" =>
        $token match =>
          "+" => fn => +
          "-" => fn => -
          "*" => fn => *
          "/" => fn => /
        fold($stack[-1, -2])
        $stack := drop(2) | append
      if numeric? => $stack := append (parseInt $token ?!)
      _ => return ValueError("Unexpected Token")
    end
  end
  last $stack
end
