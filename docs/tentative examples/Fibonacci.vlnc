define fibonacci1(n: Number) =>
  if ($n == 0) => 0
  else if ($n == 1) => 1
  else =>
    0 1 unfold => peek: +
    $[$n - 2]
  end
end

@recursive
define fibonacci2(n: Number) -> Number =>
  if ($n == 0) => 0
  else if ($n == 1) => 1
  else => sum this [$n - 1, $n - 2]
end

define fibonacci3(n: Number) =>
  $(prev, next) = 0, 1
  $iterations = 0

  while ($iterations < $n) =>
    $(prev, next) = $next, $prev + $next
    $iterations := + 1
  end

  $prev
end
