#? Imperative Style
range(1, 100) map: fn (n) =>
  if $n % 15 == 0 => println("FizzBuzz")
  else if $n % 5 == 0 => println("Buzz")
  else if $n % 3 == 0 => println("Fizz")
  else => println($n)
end

#? Array Style
range(1, 100) at (n) =>
  % [3, 5] == 0
  * ["Fizz", "Buzz"]
  fold: + | or toString $n
end