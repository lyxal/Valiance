$surface: #171a22;
$ink: #d4daea;
$divider: #667088;

Screen { background: $surface; color: $ink; }
#file-strip { height: 3; }
#file-strip Button { min-width: 10; height: 3; margin-right: 1; }
#working-area { height: 1fr; min-height: 5; }
#documents-view { width: 1fr; }
SourceEditor { height: 1fr; border: none; }
#inspector { width: 32; padding: 1; background: #202532; }
PaneDivider { color: $divider; background: #282d3b; }
PaneDivider:hover { background: #3a4b65; color: #bfcfe6; }
PaneDivider:focus { background: #526380; color: white; }
#state-divider { width: 3; height: 1fr; }
#repl-divider { height: 1; }
#repl { height: 12; min-height: 8; }
#transcript {
    height: 1fr;
    min-height: 3;
    border: solid $divider;
    border-title-color: $ink;
    background: $surface;
}
#command {
    height: 4;
    min-height: 4;
    border: solid $divider;
    border-title-color: $ink;
    background: #242e41;
}
#command:focus { border: solid #8bb9df; border-title-color: #8bb9df; }
#lock-status, #status { height: 1; color: $divider; }
