object Counter =>
  $value: Int
  private $timesIncremented = 0

  define Counter(initialValue: Int) => $self.value = $initialValue

  @self define increment =>
    $self.value := + 1
    $self.timesIncremented := + 1
  end

  @self define add(:Int) =>
    $self.value := +
    $self.timesIncremented := + 1
  end

  define incCount => $self.timesIncremented
end

Counter(0)
increment increment increment
add(5)
dup | $.value | println
incCount | println