$flatten = @recursive fn[T] (list: T~) -> T+ =>
  $flattened: T+ = []
  $list foreach (item) =>
    $item match =>
      as lst: T+ => $lst
      as scl: T  => [$scl]
              _  => this($item)
    end
    $flattened := addAll
  end
  $flattened
end

println $flatten([[1, 2, 3], [[4, 5], [6]], 7])