+        if instruction.op in {
+            OpCode.JUMP,
+            OpCode.RETURN,
+            OpCode.RETURN_SIGNAL,
+            OpCode.PANIC,
+            OpCode.MATCH_ERROR,
+            OpCode.LOOP_BREAK,
+        }:
+            depth = 0
+    return tuple(depths)
