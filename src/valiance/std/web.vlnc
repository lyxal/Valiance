import {std.file.#byte, std.html}

#? Web routing values, protocol-independent requests, and responses.
#? A bounded HTTP/1.1 adapter is available; full v1.0 transport support is pending.

#? HTTP errors are ordinary Valiance Err values, not thrown exceptions.
#? Configuration failures do not become ordinary HTTP responses.
@errType public variant ConfigError =>
  InvalidRoute
end

@errType public variant Error =>
  BadRequest
  MissingParam
  AmbiguousParam
  InvalidHeader
  AmbiguousHeader
  InvalidCookie
  AmbiguousCookie
  InvalidForm
  InvalidMultipart
  InvalidJson
  BadText
  MalformedTarget
  Unauthorized
  Forbidden
  NotFound
  MethodNotAllowed
  NotAcceptable
  RequestTimeout
  Conflict
  Gone
  PreconditionFailed
  BodyTooLarge
  TargetTooLong
  UnsupportedMediaType
  RangeNotSatisfiable
  UnprocessableContent
  TooEarly
  PreconditionRequired
  TooManyRequests
  HeadersTooLarge
  MissingContext
  BodyUnavailable
  WrongMode
  InvalidResponse
  InvalidLocation
  InvalidETag
  InvalidCachePolicy
  Internal
  NotImplemented
  BadGateway
  ServiceUnavailable
  GatewayTimeout
end

public variant SameSite =>
  Strict
  Lax
  None
end

#? Buffered is the default. Stream switches body admission before HTTP reads.
public variant BodyMode =>
  Buffered
  Stream
end

public variant Method =>
  GET
  HEAD
  POST
  PUT
  PATCH
  DELETE
  OPTIONS
  QUERY
end

public variant Status =>
  Continue
  SwitchingProtocols
  Processing
  EarlyHints
  OK
  Created
  Accepted
  NonAuthoritativeInformation
  NoContent
  ResetContent
  PartialContent
  MultiStatus
  AlreadyReported
  IMUsed
  MultipleChoices
  MovedPermanently
  Found
  SeeOther
  NotModified
  UseProxy
  TemporaryRedirect
  PermanentRedirect
  BadRequest
  Unauthorized
  PaymentRequired
  Forbidden
  NotFound
  MethodNotAllowed
  NotAcceptable
  ProxyAuthenticationRequired
  RequestTimeout
  Conflict
  Gone
  LengthRequired
  PreconditionFailed
  ContentTooLarge
  URITooLong
  UnsupportedMediaType
  RangeNotSatisfiable
  ExpectationFailed
  ImATeapot
  MisdirectedRequest
  UnprocessableContent
  Locked
  FailedDependency
  TooEarly
  UpgradeRequired
  PreconditionRequired
  TooManyRequests
  RequestHeaderFieldsTooLarge
  UnavailableForLegalReasons
  InternalServerError
  NotImplemented
  BadGateway
  ServiceUnavailable
  GatewayTimeout
  HTTPVersionNotSupported
  VariantAlsoNegotiates
  InsufficientStorage
  LoopDetected
  NotExtended
  NetworkAuthenticationRequired
  Custom =>
    $code: Int
  end
end

#? An opaque request-local key. Its private nonce is minted natively; callers
#? cannot recover another key's value from the same payload type.
public object[T] ContextKey =>
  private $token: Int = 0
  private $authenticator: Int = 0

  define ContextKey =>
    $nonce = std.web.nativeContextNonce
    $self.token = $nonce
    $self.authenticator = std.web.nativeContextAuthenticator($nonce)
  end
end

public object Headers =>
  private $names: String+? = \None
  private $values: String+? = \None
end

public object Params =>
  private $names: String+? = \None
  private $values: String+? = \None
end

#? Cookie pairs preserve repeated names and their wire order, independently
#? of query and form parameter encoding rules.
public object CookiePairs =>
  private $names: String+? = \None
  private $values: String+? = \None
end

#? Bounded buffered multipart form data; file contents are kept as exact bytes.
#? This is not yet a streaming or owned-upload resource interface.
public object MultipartForm =>
  $fields: Params
  private $files: Upload+? = \None
end

public object Upload =>
  $filename: String?
  $contentType: String?
  $size: Int
  private $fieldName: String
  private $data: #byte+ Int+
end

#? Ordered event from a streaming multipart request. For files, value is
#? None and bytes must be read/discarded through the owning UploadStream.
public object MultipartPart =>
  $name: String
  $filename: String?
  $contentType: String?
  $value: String?
end

#? One-pass multipart/form-data owner. Text fields are bounded and returned as
#? events; file bytes are pulled separately without buffering entire uploads.
@nodup("A web.UploadStream owns a multipart request and cannot be duplicated")
public object UploadStream =>
  private $token: Int

  public define ~UploadStream =>
    std.web.nativeCloseMultipartStream $self.token
  end
end

#? Current representation state supplied explicitly by application code.
#? Call preconditions before mutating state, under the application's lock or
#? transaction; HTTP validation is not a substitute for synchronization.
public object Validators =>
  $etag: String? = \None
  $lastModified: Int? = \None
  $exists: Int = 1
end

#? An exclusive pull source. The read callback returns at most the requested
#? byte count; None is EOF. close runs exactly once on completion or failure.
@nodup("A web.ByteSource owns a read/close resource")
public object ByteSource =>
  $read: Function[Int -> #byte+ Int+ | None | Error]
  $close: Function[-> None | Error]
end

#? One validated server-sent event. CR/LF/NUL are forbidden in event and ID
#? labels; multiline data is emitted as individual `data:` lines.
public object Event =>
  $data: String
  $event: String? = \None
  $id: String? = \None
  $retryMs: Int? = \None
end

#? An exclusive pull source for server-sent events. next returns None at EOF.
@nodup("A web.EventSource owns event callbacks and cannot be duplicated")
public object EventSource =>
  $next: Function[-> web.Event | None | Error]
  $close: Function[-> None | Error]
end

@nodup("A web.StreamBody owns its source and cannot be duplicated")
public object StreamBody =>
  private $token: Int

  public define ~StreamBody =>
    std.web.nativeCloseStream $self.token
  end
end

#? Linear, bounded incoming body. The transport closes unread connections.
@nodup("An incoming request stream can be owned by only one reader")
public object RequestBodyStream =>
  private $token: Int

  public define ~RequestBodyStream =>
    std.web.nativeCloseRequestStream $self.token
  end
end

public object Response =>
  $status: Int | Status = 200
  $body: String | html.Node | #byte+ Int+ | StreamBody = ""
  private $headers: Headers? = \None
  private $earlyHints: String+? = \None
  private $trailers: Headers? = \None
end

public variant Request =>
  GetRequest =>
    $path: String
    $rawTarget: String
    $originalMethod: String
    $routeParams: Dict[String, String]
    $query: Params
    $headers: Headers
    $body: String
    private $streamToken: Int = 0
    private $multipartPolicy: Dict[String, Int]
    $scheme: String
    $authority: String
    $protocol: String
    $requestId: String
    $peer: String
    $clientAddress: String
  end
  HeadRequest =>
    $path: String
    $rawTarget: String
    $originalMethod: String
    $routeParams: Dict[String, String]
    $query: Params
    $headers: Headers
    $body: String
    private $streamToken: Int = 0
    private $multipartPolicy: Dict[String, Int]
    $scheme: String
    $authority: String
    $protocol: String
    $requestId: String
    $peer: String
    $clientAddress: String
  end
  PostRequest =>
    $path: String
    $rawTarget: String
    $originalMethod: String
    $routeParams: Dict[String, String]
    $query: Params
    $headers: Headers
    $body: String
    private $streamToken: Int = 0
    private $multipartPolicy: Dict[String, Int]
    $scheme: String
    $authority: String
    $protocol: String
    $requestId: String
    $peer: String
    $clientAddress: String
  end
  PutRequest =>
    $path: String
    $rawTarget: String
    $originalMethod: String
    $routeParams: Dict[String, String]
    $query: Params
    $headers: Headers
    $body: String
    private $streamToken: Int = 0
    private $multipartPolicy: Dict[String, Int]
    $scheme: String
    $authority: String
    $protocol: String
    $requestId: String
    $peer: String
    $clientAddress: String
  end
  PatchRequest =>
    $path: String
    $rawTarget: String
    $originalMethod: String
    $routeParams: Dict[String, String]
    $query: Params
    $headers: Headers
    $body: String
    private $streamToken: Int = 0
    private $multipartPolicy: Dict[String, Int]
    $scheme: String
    $authority: String
    $protocol: String
    $requestId: String
    $peer: String
    $clientAddress: String
  end
  DeleteRequest =>
    $path: String
    $rawTarget: String
    $originalMethod: String
    $routeParams: Dict[String, String]
    $query: Params
    $headers: Headers
    $body: String
    private $streamToken: Int = 0
    private $multipartPolicy: Dict[String, Int]
    $scheme: String
    $authority: String
    $protocol: String
    $requestId: String
    $peer: String
    $clientAddress: String
  end
  OptionsRequest =>
    $path: String
    $rawTarget: String
    $originalMethod: String
    $routeParams: Dict[String, String]
    $query: Params
    $headers: Headers
    $body: String
    private $streamToken: Int = 0
    private $multipartPolicy: Dict[String, Int]
    $scheme: String
    $authority: String
    $protocol: String
    $requestId: String
    $peer: String
    $clientAddress: String
  end
  QueryRequest =>
    $path: String
    $rawTarget: String
    $originalMethod: String
    $routeParams: Dict[String, String]
    $query: Params
    $headers: Headers
    $body: String
    private $streamToken: Int = 0
    private $multipartPolicy: Dict[String, Int]
    $scheme: String
    $authority: String
    $protocol: String
    $requestId: String
    $peer: String
    $clientAddress: String
  end
  #? An upgrade handshake, not a GET or ordinary CONNECT route.
  WebSocketRequest =>
    $path: String
    $rawTarget: String
    $originalMethod: String
    $routeParams: Dict[String, String]
    $query: Params
    $headers: Headers
    $body: String
    private $streamToken: Int = 0
    private $multipartPolicy: Dict[String, Int]
    $scheme: String
    $authority: String
    $protocol: String
    $requestId: String
    $peer: String
    $clientAddress: String
  end
end

#? Each handler receives a nominal method-specific view; middleware uses the
#? closed Request variant so that original method identity remains explicit.

public object GetRequest =>
  $path: String
  $rawTarget: String
  $originalMethod: String
  $routeParams: Dict[String, String]
  $query: Params
  $headers: Headers
  $body: String
  private $streamToken: Int = 0
  private $multipartPolicy: Dict[String, Int]
  $scheme: String
  $authority: String
  $protocol: String
  $requestId: String
  $peer: String
  $clientAddress: String
end

