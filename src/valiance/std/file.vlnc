import {std.path}
public import {std.file.do as do}
#? Sequential file operations with deterministic resource release.

public tag #byte as unit
#?? Validate that a byte is an Int in the inclusive range 0 to 255.
#??
#?? @param value Candidate integer value.
#?? @returns True if the value is an unsigned 8-bit byte.
#?? @example import {std.file.#byte} 65 #byte
public define #byte(:Int) => inRange(0, 256)


public variant Encoding =>
  UTF8
  UTF16LE
  UTF16BE
  Latin1
end

@nodup("File handles must not be duplicated")
public object ReadFile =>
  private $handle: Int = 0

  define ReadFile(path: path.Path, encoding: Encoding = Encoding.\UTF8) =>
    $self.handle = std.file.openRead($path, $encoding)
  end

  @returnAll public define readLine =>
    std.file.readLineHandle($self.handle)
    $self
    swap
  end

  @returnAll public define readLines =>
    std.file.readLinesHandle($self.handle)
    $self
    swap
  end

  @returnAll public define readText =>
    std.file.readTextHandle($self.handle)
    $self
    swap
  end

  @returnAll public define readBytes(count: Int) =>
    std.file.readBytesHandle($self.handle, $count)
    $self
    swap
  end

  @returnAll public define readAllBytes =>
    std.file.readAllBytesHandle($self.handle)
    $self
    swap
  end

  public define close =>
    std.file.closeHandle($self.handle)
  end

  public define ~ReadFile =>
    std.file.closeHandle($self.handle)
  end
end

@nodup("File handles must not be duplicated")
public object WriteFile =>
  private $handle: Int = 0

  define WriteFile(path: path.Path, encoding: Encoding = Encoding.\UTF8) =>
    $self.handle = std.file.openWrite($path, $encoding)
  end

  @self public define writeText(text: String) =>
    std.file.writeTextHandle($self.handle, $text)
  end

  @self public define writeLine(line: String) =>
    std.file.writeLineHandle($self.handle, $line)
  end

  @self public define writeLines(lines: String+) =>
    std.file.writeLinesHandle($self.handle, $lines)
  end

  @self public define writeBytes(bytes: #byte+ Int+) =>
    std.file.writeBytesHandle($self.handle, $bytes)
  end

  @self public define flush =>
    std.file.flushHandle($self.handle)
  end

  public define close =>
    std.file.closeHandle($self.handle)
  end

  public define ~WriteFile =>
    std.file.closeHandle($self.handle)
  end
end

@nodup("File handles must not be duplicated")
public object AppendFile =>
  private $handle: Int = 0

  define AppendFile(path: path.Path, encoding: Encoding = Encoding.\UTF8) =>
    $self.handle = std.file.openAppend($path, $encoding)
  end

  @self public define writeText(text: String) =>
    std.file.writeTextHandle($self.handle, $text)
  end

  @self public define writeLine(line: String) =>
    std.file.writeLineHandle($self.handle, $line)
  end

  @self public define writeLines(lines: String+) =>
    std.file.writeLinesHandle($self.handle, $lines)
  end

  @self public define writeBytes(bytes: #byte+ Int+) =>
    std.file.writeBytesHandle($self.handle, $bytes)
  end

  @self public define flush =>
    std.file.flushHandle($self.handle)
  end

  public define close =>
    std.file.closeHandle($self.handle)
  end

  public define ~AppendFile =>
    std.file.closeHandle($self.handle)
  end
end
